  "items": [
    {
      "name": "t-flavored-style",
      "type": "registry:style",
      "title": "T-flavored Style",
      "description": "t-flavored design tokens (colors, typography, radius) and Tailwind theme wiring.",
      "dependencies": ["tw-animate-css"],
      "files": [
        {
          "path": "src/styles/global.css",
          "type": "registry:file",
          "target": "src/app/globals.css"
        },
        {
          "path": "src/styles/theme.css",
          "type": "registry:file",
          "target": "src/app/theme.css"
        }
      ],
      "docs": "Import the generated globals.css from your app's root layout once before using t-flavored components."
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
      "description": "The cn helper, configured with the t-flavored typography scale so class merging keeps sizes and colors apart.",
