{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "kcn-montage",
  "homepage": "https://github.com/SeyoungCho/kcn",
  "items": [
    {
      "name": "montage-style",
      "type": "registry:style",
      "title": "Montage Style",
      "description": "montage design tokens (colors, typography, radius, shadows) and Tailwind theme wiring.",
      "dependencies": ["tw-animate-css"],
      "files": [
        {
          "path": "src/styles/global.css",
          "type": "registry:file",
          "target": "src/app/globals.css"
        },
        {
          "path": "src/styles/theme.css",
          "type": "registry:file",
          "target": "src/app/theme.css"
        }
      ],
      "docs": "Import the generated globals.css from your app's root layout once before using montage components."
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
      "description": "The cn helper, configured with the montage type, radius and shadow scales so class merging keeps them apart.",
      "dependencies": ["cn"],
      "files": [
        {
          "path": "src/lib/utils.ts",
          "type": "registry:lib",
          "target": "@lib/utils.ts"
        }
      ]
    },
