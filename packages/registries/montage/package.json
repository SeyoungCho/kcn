{
  "name": "@repo/montage",
  "version": "1.0.0",
  "private": true,
  "description": "shadcn registry for montage components",
  "author": "SeyoungCho <wnl383@naver.com> (https://github.com/SeyoungCho)",
  "license": "MIT",
  "exports": {
    "./ui/*": {
      "types": "./dist/types/components/ui/*.d.ts",
      "default": "./src/components/ui/*.tsx"
    },
    "./lib/*": {
      "types": "./dist/types/lib/*.d.ts",
      "default": "./src/lib/*.ts"
    },
    "./mdx": {
      "types": "./dist/types/mdx.d.ts",
      "default": "./src/mdx.ts"
    },
    "./styles/global.css": {
      "style": "./src/styles/global.css",
      "default": "./src/styles/global.css"
    },
    "./styles/theme.css": {
      "style": "./src/styles/theme.css",
      "default": "./src/styles/theme.css"
    }
  },
  "scripts": {
    "build": "node ../../../scripts/build-registry-types.mjs",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "postcss": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-classnames": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:"
  },
  "volta": {
    "node": "22.22.2"
  }
}
